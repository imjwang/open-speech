{
  "name": "open-speech-app",
  "productName": "Open Speech",
  "version": "0.1.0",
  "private": true,
  "description": "Open Speech desktop shell: menu bar, voice-first command bar and reader. A thin client of the local engine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node e2e/smoke.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "gen:icons": "node scripts/make-tray-icons.mjs",
    "engine:bundle": "bash scripts/bundle-engine.sh",
    "dist:mac": "pnpm build && pnpm engine:bundle && electron-builder --mac --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "lucide-react": "^1.77.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
