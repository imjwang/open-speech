# Open Speech engine configuration (read from the repo root by pydantic-settings).
# Every key is optional. With none set, Open Speech reads with the local Kokoro voice
# and Classic (deterministic) cleanup rules.

# Claude: rules compiler, AI Enhanced cleanup, image descriptions, assistant.
ANTHROPIC_API_KEY=

# OpenAI: TTS (gpt-4o-mini-tts) and speech-to-text for the command bar.
OPENAI_API_KEY=

# Gemini: TTS (gemini-3.8-flash-tts via the Interactions API) and speech-to-text.
GEMINI_API_KEY=

# Optional overrides
# OPEN_SPEECH_HOME=              # app data dir (default: per-OS application support dir)
# OPEN_SPEECH_LLM_MODEL=claude-sonnet-5-5
# OPEN_SPEECH_DEFAULT_VOICE=kokoro:kokoro-82m-v1.0:af_heart
# OPEN_SPEECH_MONTHLY_BUDGET_USD=10
# OPEN_SPEECH_LIVE=0             # 1 = run the live provider smoke tests
