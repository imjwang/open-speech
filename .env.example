# Open Speech build configuration (read from the repo root by the engine in development, and copied into
# packaged builds by app/scripts/bundle-engine.sh). Provider keys are set here before building: the app
# itself never asks for one. Every key is optional. With none set, Open Speech reads with the local Kokoro
# voice, listens with the local speech model and uses Classic (deterministic) cleanup rules.

# Claude: the assistant, the rules compiler, AI Enhanced cleanup, image descriptions.
ANTHROPIC_API_KEY=

# OpenAI: cloud voices (gpt-4o-mini-tts); cloud speech-to-text when local listening is turned off.
OPENAI_API_KEY=

# Gemini: cloud voices (gemini-3.8-flash-tts via the Interactions API); cloud speech-to-text.
GEMINI_API_KEY=

# Google Cloud Text-to-Speech: the Chirp 3 HD voices, the default voice for reading and replies while the
# month's first million characters are free. Optional: when empty, GEMINI_API_KEY is used. Either key needs
# Cloud Text-to-Speech enabled in its Google Cloud project and allowed in the key's API restrictions (without
# that Google answers 403 API_KEY_SERVICE_BLOCKED and Open Speech reads with the local voice).
GOOGLE_TTS_API_KEY=

# Optional overrides
# OPEN_SPEECH_HOME=              # app data dir (default: per-OS application support dir)
# OPEN_SPEECH_LLM_MODEL=claude-haiku-5-5
# OPEN_SPEECH_DEFAULT_VOICE=auto              # auto = Chirp Zephyr while free, else the local Kokoro voice
# OPEN_SPEECH_MONTHLY_BUDGET_USD=10
# OPEN_SPEECH_LIVE=0             # 1 = run the live provider smoke tests
